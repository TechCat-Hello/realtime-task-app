# [旧] Render + Supabase時代の環境変数例です。
# 現在の本番環境（AWS）の設定例は README.md の「デプロイ（AWS）」セクション、
# ローカル開発用の設定例はリポジトリ直下の .env.example を参照してください。

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-backend-url.onrender.com

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# CORS
CORS_ALLOWED_ORIGINS=https://your-frontend-url.onrender.com

# CSRF (for Django Admin)
CSRF_TRUSTED_ORIGINS=https://your-backend-url.onrender.com

# Slack (Optional)
SLACK_WEBHOOK_URL=your-slack-webhook-url

# Email (Optional, used for password reset). Leave EMAIL_HOST empty to just
# print reset emails to the console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@task-sync.com
FRONTEND_URL=https://task-sync.com
