# Django settings
# Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=rt_tasks
POSTGRES_USER=rt_user
POSTGRES_PASSWORD=rt_password
DATABASE_HOST=db
DATABASE_PORT=5432

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=3600

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Slack (optional)
SLACK_WEBHOOK_URL=

# Email (optional, used for password reset). Leave EMAIL_HOST empty to just
# print reset emails to the console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@task-sync.com
FRONTEND_URL=http://localhost:3000
